# IBM Watsonx Configuration
# Copy this file to .env and fill in your credentials

# Watsonx Service URL (default: US South region)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Watsonx API Version
WATSONX_VERSION=2024-05-31

# Your IBM Watsonx Project ID (required)
WATSONX_PROJECT_ID=your-project-id-here

# Your IBM Watsonx API Key (required)
WATSONX_API_KEY=your-api-key-here

# Model ID to use (default: mistralai/mistral-medium-2505)
WATSONX_MODEL_ID=mistralai/mistral-medium-2505

# MCP Server Timeout (in milliseconds, default: 300000 = 5 minutes)
MCP_TIMEOUT=300000