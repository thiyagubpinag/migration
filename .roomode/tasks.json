      "tool": "lint",
      "enabled": true,
      "config": {
        "modelId": "ibm/granite-13b-chat-v2"
      }
    },
    {
      "id": "run-changes-task",
      "name": "Run Changes Task",
      "description": "Apply code changes and transformations",
      "tool": "run-changes",
      "enabled": true,
      "config": {
        "modelId": "ibm/granite-13b-chat-v2"
      }
    },
    {
      "id": "validate-task",
      "name": "Validate Task",
      "description": "Validate code and configurations",
      "tool": "validate",
      "enabled": true,
      "config": {
        "modelId": "ibm/granite-13b-chat-v2"
      }
    },
    {
      "id": "watsonx-llm-task",
      "name": "Watsonx LLM Task",
