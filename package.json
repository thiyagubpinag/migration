{
  "name": "mcp-watsonx-llm",
  "version": "1.0.0",
  "description": "MCP tool for direct interaction with IBM Watsonx LLM",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "mcp": "node mcp-server.js",
    "mcp:dev": "node --watch mcp-server.js",
    "example": "node examples/complete-migration-example.js",
    "test": "node tests/quick-test.js",
    "test:full": "node tests/test-all-tools.js",
    "test:quick": "node tests/quick-test.js",
    "test:docupilot": "node -e \"import('./tools/docupilot-agent/index.js').then(m => new m.DocuPilotAgent().execute({targetVersion: '21'}).then(console.log))\"",
    "test:analyzer": "node -e \"import('./tools/code-analyzer/index.js').then(m => console.log('Code Analyzer loaded'))\"",
    "test:recommendation": "node -e \"import('./tools/code-recommendation/index.js').then(m => console.log('Code Recommendation loaded'))\"",
    "validate": "node tests/quick-test.js"
  },
  "keywords": [
    "mcp",
    "watsonx",
    "langchain",
    "llm"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/community": "^0.3.58",
    "@langchain/core": "^0.3.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.5",
    "java-parser": "^3.0.1",
    "langchain": "^0.3.0"
  }
}
