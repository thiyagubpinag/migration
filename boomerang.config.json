{
  "name": "mcp-watsonx-llm",
  "version": "1.0.0",
  "description": "MCP tool for IBM Watsonx LLM integration",
  "type": "task",
  "category": "ai",
  "runtime": "node",
  "entrypoint": "index.js",
  "parameters": [
    {
      "name": "tool",
      "type": "string",
      "required": true,
      "description": "Tool to execute",
      "enum": ["watsonx_llm"]
    },
    {
      "name": "modelId",
      "type": "string",
      "required": false,
      "description": "IBM Watsonx model ID to use",
      "default": "mistralai/mistral-medium-2505"
    },
    {
      "name": "projectId",
      "type": "string",
      "required": false,
      "description": "IBM Watsonx project ID (overrides env var)"
    },
    {
      "name": "params",
      "type": "object",
      "required": false,
      "description": "Tool-specific parameters"
    }
  ],
  "environment": {
    "WATSONX_URL": {
      "required": false,
      "description": "IBM Watsonx service URL"
    },
    "WATSONX_VERSION": {
      "required": false,
      "description": "IBM Watsonx API version"
    },
    "WATSONX_PROJECT_ID": {
      "required": true,
      "description": "IBM Watsonx project ID"
    },
    "WATSONX_API_KEY": {
      "required": true,
      "description": "IBM Watsonx API key",
      "secret": true
    },
    "WATSONX_MODEL_ID": {
      "required": false,
      "description": "Default model ID to use"
    }
  },
  "outputs": [
    {
      "name": "result",
      "type": "object",
      "description": "Tool execution result"
    }
  ],
  "tags": ["mcp", "watsonx", "langchain", "ai", "llm"],
  "author": "ROO Team",
  "license": "ISC"
}